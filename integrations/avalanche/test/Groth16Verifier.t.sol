pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {AVIPRegistry} from "../contracts/AVIPRegistry.sol";
import {AVIPValidatorManager} from "../contracts/AVIPValidatorManager.sol";
import {Groth16Verifier} from "../contracts/verifiers/Groth16Verifier.sol";
import {Bn254} from "../contracts/verifiers/Bn254.sol";
import {IAVIPRegistry} from "../contracts/interfaces/IAVIPRegistry.sol";
import {Groth16Fixtures} from "./fixtures/Groth16Fixtures.sol";

/// WHAT IS TESTED
/// --------------
/// 1. The wrapper, end to end, against the EVM's own precompiles: a real BN254
///    Groth16 equation (four pairings, `k = 4`) is accepted, and every single
///    coordinate of the statement matters — changing the root, the epoch or the
///    certified norm flips the answer to `false`.
/// 2. Failure modes are told apart: a well-formed proof that does not satisfy
///    the equation returns `false`, while a proof whose points are not on the
///    curve reverts with `Bn254.PrecompileFailed(0x08)`. Neither is silent.
/// 3. The installed key is the key: the constructor refuses an empty `ic` and a
///    key with an off-curve point, `verifyingKeyDigest()` is
///    `keccak256(abi.encode(vk))` of exactly what was installed, and the key
///    getters return it.
/// 4. The statement is the caller's, not the proof's: `verify` rejects a
///    statement of the wrong arity instead of padding or truncating it.
/// 5. The integration the plan asks for (§5.4): `AVIPRegistry` (which builds the
///    statement from its own stored root and the certified norm, and decodes the
///    blob through `Bn254`) and `AVIPValidatorManager` (which enforces `Theta_r`)
///    both accept the fixture proof, and reject it when the certified norm does
///    not match the statement the proof was built for.
/// 6. Cost: the measured gas of one `verify` call is logged and bounded. The
///    pairings alone are `45_000 + 34_000 * 4 = 181_000` (EIP-197), the figure
///    the paper's `GasBenchmarks.sol` measurement of `k = 4` reproduces.
///
/// WHAT IS NOT TESTED, AND WHY THAT IS THE HONEST BOUNDARY
/// ------------------------------------------------------
/// - **The fixtures certify nothing.** `test/fixtures/Groth16Fixtures.sol` is
///   generated by `scripts/generate_groth16_fixtures.py`: there is no circuit
///   and no trusted setup, the scalars are derived from public labels and `c` is
///   solved so that the pairing equation holds. It exercises this wrapper; it is
///   not a proof about a tensor. M4b's own fixture
///   (`test/fixtures/M4bGroth16Fixtures.sol`) is the opposite case — a real key
///   over the V3 circuit and a real proof, verified by `test/M4bRealKey.t.sol` —
///   and this file keeps the synthetic one because it is what drives the
///   off-curve, identity, arity and gas paths that a real key cannot produce.
/// - **No ceremony-grade key, and no recursive SNARK or Pedersen/Bulletproofs
///   circuit.** M4b installs a *development* key over V3 — one phase-2
///   contributor, committed seeds, no security claim (§5.5.4, §5.5.9) — which is
///   what `test/M4bRealKey.t.sol` exercises; a deployment calls this same
///   constructor with the ceremony's key, and the recursive construction is still
///   the parallel cryptography workstream.
/// - **No adversarial-key testing** (a fabricated `ic` that makes some
///   statement verify): the soundness of Groth16 against a malicious key is a
///   property of the key's provenance — the ceremony — not of the wrapper.
contract Groth16VerifierTest is Test {
    uint256 internal constant THETA_R = 5e17;
    uint256 internal constant SF_AT_THETA_R = 733_333_333_333_333_334;
    uint32 internal constant N = 500;

    Groth16Verifier internal verifier;

    address internal sequencer;
    address internal slashAuthority;
    address internal validator;

    function setUp() public {
        verifier = new Groth16Verifier(Groth16Fixtures.verifyingKey());

        sequencer = makeAddr("sequencer");
        slashAuthority = makeAddr("slashAuthority");
        validator = makeAddr("validator");
    }

    /// @dev The blob the registry consumes: `(a, b, c)`, 256 bytes.
    function proof() internal pure returns (bytes memory) {
        return
            abi.encode(Groth16Fixtures.proofA(), Groth16Fixtures.proofB(), Groth16Fixtures.proofC());
    }

    // ------------------------------------------------------------ constructor

    function test_constructor_installsTheKeyAndAnnouncesItsDigest() public {
        Groth16Verifier.VerifyingKey memory expected = Groth16Fixtures.verifyingKey();
        bytes32 digest = keccak256(abi.encode(expected));

        vm.expectEmit(true, false, false, true);
        emit Groth16Verifier.VerifyingKeyInstalled(digest, 3);
        Groth16Verifier fresh = new Groth16Verifier(expected);

        assertEq(fresh.verifyingKeyDigest(), digest);
        assertEq(fresh.numPublicInputs(), 3);
        assertEq(fresh.icLength(), 4);
    }

    function test_constructor_rejectsAnEmptyKey() public {
        Groth16Verifier.VerifyingKey memory empty;
        empty.alpha1 = [uint256(1), uint256(2)];
        empty.ic = new uint256[2][](0);

        vm.expectRevert(Groth16Verifier.InvalidVerifyingKey.selector);
        new Groth16Verifier(empty);
    }

    function test_constructor_rejectsAKeyWithAnOffCurvePoint() public {
        // `(1, 1)` is not on `y^2 = x^3 + 3`: the key cannot verify anything, so
        // the constructor refuses it rather than deploying a dead verifier.
        Groth16Verifier.VerifyingKey memory offCurve = Groth16Fixtures.verifyingKey();
        offCurve.alpha1 = [uint256(1), uint256(1)];

        vm.expectRevert(Groth16Verifier.InvalidVerifyingKey.selector);
        new Groth16Verifier(offCurve);
    }

    // ------------------------------------------------------------- the key

    function test_getters_returnTheInstalledKey() public view {
        Groth16Verifier.VerifyingKey memory key = Groth16Fixtures.verifyingKey();

        uint256[2] memory alpha = verifier.alpha1();
        assertEq(alpha[0], key.alpha1[0]);
        assertEq(alpha[1], key.alpha1[1]);

        uint256[2][2] memory beta = verifier.beta2();
        assertEq(beta[0][0], key.beta2[0][0]);
        assertEq(beta[1][1], key.beta2[1][1]);

        uint256[2][2] memory gamma = verifier.gamma2();
        assertEq(gamma[0][1], key.gamma2[0][1]);

        uint256[2][2] memory delta = verifier.delta2();
        assertEq(delta[1][0], key.delta2[1][0]);

        for (uint256 i = 0; i < verifier.icLength(); ++i) {
            uint256[2] memory ic = verifier.icAt(i);
            assertEq(ic[0], key.ic[i][0]);
            assertEq(ic[1], key.ic[i][1]);
        }
    }

    function test_fixtureCertifiesTheManagersThreshold() public pure {
        // The fixtures are only useful for the integration below if the norm
        // they certify is the one `AVIPValidatorManager` enforces at admission.
        assertEq(Groth16Fixtures.STATEMENT_NORM, THETA_R);
        assertEq(Groth16Fixtures.STATEMENT_EPOCH, 0);
        assertEq(Groth16Fixtures.STATEMENT_ROOT, uint256(keccak256("tensor")));
    }

    // ------------------------------------------------------------ the verdict

    function test_verify_acceptsTheFixtureProof() public view {
        bool accepted = verifier.verify(
            Groth16Fixtures.proofA(),
            Groth16Fixtures.proofB(),
            Groth16Fixtures.proofC(),
            Groth16Fixtures.statement()
        );
        assertTrue(accepted);
    }

    function test_verify_acceptsTheStatementTheRegistryBuilds() public view {
        // The registry does not take the statement from the caller: it builds
        // `[root, epoch, certifiedNorm]` from storage plus the norm it is asked
        // to certify. That is the array this test assembles by hand.
        uint256[] memory statement = new uint256[](3);
        statement[0] = uint256(keccak256("tensor"));
        statement[1] = 0;
        statement[2] = THETA_R;

        assertTrue(
            verifier.verify(
                Groth16Fixtures.proofA(),
                Groth16Fixtures.proofB(),
                Groth16Fixtures.proofC(),
                statement
            )
        );
    }

    function test_verify_rejectsAnotherRoot() public view {
        uint256[] memory statement = Groth16Fixtures.statement();
        statement[0] = statement[0] + 1;
        assertFalse(verifyWith(statement));
    }

    function test_verify_rejectsAnotherEpoch() public view {
        uint256[] memory statement = Groth16Fixtures.statement();
        statement[1] = 1;
        assertFalse(verifyWith(statement));
    }

    function test_verify_rejectsAnotherNorm() public view {
        uint256[] memory statement = Groth16Fixtures.statement();
        statement[2] = THETA_R + 1;
        assertFalse(verifyWith(statement));
    }

    function test_verify_rejectsAZeroNormAsAVerdictNotAsAFailure() public view {
        // `_vkX` skips zero inputs, so no `0x07` call is made with a zero scalar
        // and nothing hands `(0, 0)` to `0x06`. A zero norm is simply a statement
        // the proof does not satisfy.
        uint256[] memory statement = Groth16Fixtures.statement();
        statement[2] = 0;
        assertFalse(verifyWith(statement));
    }

    function test_verify_rejectsAWellFormedProofOfAnotherEquation() public view {
        // `A = G1` is on the curve, so 0x08 accepts the input and the answer is a
        // verdict (`false`), not a revert: the two failure modes stay distinct.
        uint256[2] memory wrongA = [uint256(1), uint256(2)];
        assertFalse(
            verifier.verify(
                wrongA,
                Groth16Fixtures.proofB(),
                Groth16Fixtures.proofC(),
                Groth16Fixtures.statement()
            )
        );
    }

    function test_verify_revertsWhenAProofPointIsOffTheCurve() public {
        uint256[2] memory offCurve = [uint256(1), uint256(1)];

        vm.expectRevert(abi.encodeWithSelector(Bn254.PrecompileFailed.selector, 0x08));
        verifier.verify(
            offCurve,
            Groth16Fixtures.proofB(),
            Groth16Fixtures.proofC(),
            Groth16Fixtures.statement()
        );
    }

    function test_verify_rejectsAStatementOfTheWrongLength() public {
        uint256[] memory twoInputs = new uint256[](2);
        twoInputs[0] = Groth16Fixtures.STATEMENT_ROOT;
        twoInputs[1] = Groth16Fixtures.STATEMENT_EPOCH;

        vm.expectRevert(abi.encodeWithSelector(Groth16Verifier.PublicInputsMismatch.selector, 3, 2));
        verifier.verify(
            Groth16Fixtures.proofA(), Groth16Fixtures.proofB(), Groth16Fixtures.proofC(), twoInputs
        );

        uint256[] memory fourInputs = new uint256[](4);
        vm.expectRevert(abi.encodeWithSelector(Groth16Verifier.PublicInputsMismatch.selector, 3, 4));
        verifier.verify(
            Groth16Fixtures.proofA(), Groth16Fixtures.proofB(), Groth16Fixtures.proofC(), fourInputs
        );
    }

    /// @dev `verify` with the fixture proof and a chosen statement.
    function verifyWith(uint256[] memory statement) internal view returns (bool) {
        return verifier.verify(
            Groth16Fixtures.proofA(), Groth16Fixtures.proofB(), Groth16Fixtures.proofC(), statement
        );
    }

    // ------------------------------------------------------------------- cost

    function test_verify_costsAboutFourPairings() public {
        // Warm the account once: inside a block the registry is not the first
        // caller, and the measurement should not include the cold ACCESS_LIST
        // charge for a first touch of the verifier.
        assertTrue(verifyWith(Groth16Fixtures.statement()));

        uint256 before = gasleft();
        bool accepted = verifyWith(Groth16Fixtures.statement());
        uint256 used = before - gasleft();

        emit log_named_uint("verify(a, b, c, statement) gas", used);
        assertTrue(accepted);

        // EIP-197 charges `45_000 + 34_000 * k`, so the four pairings alone are
        // `181_000`: the paper's `181,142 gas` for the pairing step and `~206k`
        // for a whole verification (cross-checked in
        // `benchmarks/src/GasBenchmarks.sol`). Everything above that is the
        // `vk_x` accumulation (two `0x07` calls and one `0x06`) plus reloading
        // the key from storage, which the benchmark's hardcoded-key verifier
        // does not pay.
        assertGt(used, 181_000);
        assertLt(used, 300_000);
    }

    // ------------------------------------------------------------ integration

    function test_registry_acceptsTheFixtureProofAndBindsItToTheNorm() public {
        AVIPRegistry registry = new AVIPRegistry(sequencer, address(verifier));
        vm.prank(sequencer);
        registry.postCommitment(0, keccak256("tensor"), N);

        bytes memory blob = proof();

        // The statement is built by the registry from its own root and the norm
        // it is asked to certify, and decoded by `Bn254`: this is M1's wiring
        // running against the real verifier instead of the mock.
        assertTrue(registry.verifyThreshold(0, THETA_R, blob));

        // A norm the proof was not built for is a `false`, not an accepted
        // proof: the statement is inside the equation.
        assertFalse(registry.verifyThreshold(0, THETA_R + 1, blob));
    }

    function test_manager_admitsAValidatorWithTheFixtureProof() public {
        AVIPRegistry registry = new AVIPRegistry(sequencer, address(verifier));
        vm.prank(sequencer);
        registry.postCommitment(0, keccak256("tensor"), N);

        AVIPValidatorManager manager =
            new AVIPValidatorManager(address(registry), slashAuthority, address(0));

        vm.prank(validator);
        manager.admit(validator, SF_AT_THETA_R, THETA_R, proof());

        assertTrue(manager.isAdmitted(validator));
        assertEq(manager.stakeOf(validator), SF_AT_THETA_R);
        assertEq(manager.requiredStake(validator), SF_AT_THETA_R);
        assertEq(manager.collateralOf(validator), 1e18 - SF_AT_THETA_R);
    }

    function test_manager_rejectsAProofWhoseStatementIsAnotherNorm() public {
        AVIPRegistry registry = new AVIPRegistry(sequencer, address(verifier));
        vm.prank(sequencer);
        registry.postCommitment(0, keccak256("tensor"), N);

        AVIPValidatorManager manager =
            new AVIPValidatorManager(address(registry), slashAuthority, address(0));

        // This is the claim M3 adds to M2: the validator cannot *declare* a norm
        // it cannot prove. `admit` reads `latestEpoch()` and hands the caller's
        // `certifiedNorm` to the registry, which puts it in the statement, so a
        // proof for `Theta_r` does not certify `Theta_r + 1`.
        vm.expectRevert(IAVIPRegistry.InvalidZKProof.selector);
        vm.prank(validator);
        manager.admit(validator, SF_AT_THETA_R, THETA_R + 1, proof());

        assertFalse(manager.isAdmitted(validator));
    }
}
