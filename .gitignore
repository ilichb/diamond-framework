# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Node
node_modules/
.next/
dist/
build/

# LaTeX
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# OpenTimestamps — `ots upgrade` moves the previous receipt to FILE.bak
# (`otsclient/cmds.py`); the value it holds is recoverable from git history,
# and the file is the on-disk copy kept for the out-of-band send.
*.ots.bak

# Secrets
.env
.env.local
*.key
*.pem
# Operator notes kept at the repository root. `credenciales safe.txt` holds an
# RPC endpoint's key in its path and the guardian addresses; it must never be
# committed, and `git add -A` at the root is exactly how it would be.
credenciales*.txt

# Results (keep .md summaries, ignore raw dumps)
verification/**/results/*.csv
verification/**/results/*.npy
verification/**/results/*.pkl

# Large binaries
*.zip
*.tar.gz

# PDFs — only track release snapshots
*.pdf
!docs/paper/releases/*.pdf

# Frozen Phase-1 baseline (retained locally as the byte-identical reference
# used by the determinism evidence; superseded by
# verification/baseline_verified/, which is the committed, anchored baseline).
verification/baseline_2026-10-06/
src/zk/target/
src/rmt/target/
src/reputation/target/
src/datalayer/target/
# copia de conveniencia; canónico: measure_block_time_output.txt
verification/baseline_verified/fuji_block_time_output.txt
